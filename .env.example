# curator-tool-llm configuration template.
# Copy this file to .env and fill in your own values:   cp .env.example .env
# .env is gitignored. Never commit real keys or passwords.
#
# .env is loaded by python-dotenv with override=True, so any variable ACTIVE in the file wins
# over your shell. Secrets below are therefore commented out: uncomment and fill one in only
# when you want this file to supply it (otherwise the value already in your shell is used).

# --- API keys ---
#ANTHROPIC_API_KEY=                 # extraction, the draft, QA and chat (required)
#OPENAI_API_KEY=                    # only for the full-text cross-model review (run_review.py, LLM_REVIEW=1)
#PUBMED_API_KEY=                    # NCBI E-utilities (raises the rate limit to 10/sec)
NCBI_EMAIL=you@example.com          # NCBI politeness; the code has its own default
NCBI_TOOL=curator-tool-llm

# --- Neo4j (Reactome graph) ---
REACTOME_NEO4J_URI=bolt://localhost:7687
REACTOME_NEO4J_USER=neo4j
#REACTOME_NEO4J_PWD=
REACTOME_NEO4J_DATABASE=graph.db    # the Reactome graph DB name (NOT "reactome")

# --- MongoDB: PubMed abstract cache (also holds sessions when SESSION_STORE=mongo) ---
# Include credentials in the URI if your Mongo needs them: mongodb://USER:PASSWORD@localhost:27017
PUBMED_MONGO_URI=mongodb://localhost:27017
PUBMED_MONGO_DB=pubmed_abstract
PUBMED_MONGO_COLLECTION=pmid2abstract

# --- MongoDB: Reactome functional-interaction partners (pathway placement) ---
FIS_MONGO_DB=idg_pairwise
FIS_MONGO_GENE_INDEX=GENE_INDEX             # collection name for the gene index
FIS_MONGO_RELATIONSHIPS=relationships       # collection name for the pairwise relationships

TOKENIZERS_PARALLELISM=false
PDF_PAPERS_FOLDER=data/papers/

# --- REST service (see README, "Run as a RESTful service") ---
WS_BASE_URL=http://localhost:9090           # curator-tool-ws: verifies tokens and roles
# Only needed by tests/test_ws_contract.py, which logs in to curator-tool-ws:
#WS_USERNAME=
#WS_PASSWORD=

# --- Optional (defaults shown) ---
#SESSION_STORE=memory               # memory, or mongo to keep sessions across restarts
#SNAPSHOT_MODE=record               # record | replay | off
#SNAPSHOT_DIR=data/snapshots
#CHAT_MODEL=claude-sonnet-5-5
#CORS_ORIGINS=http://localhost:4200  # comma-separated browser origins allowed to call the API
#UPLOAD_DIR=data/uploads
#LLM_REVIEW=1                       # also run the OpenAI cross-model review (needs OPENAI_API_KEY)
#CURATOR_LLM_ROOT=                  # defaults to this repo's directory
