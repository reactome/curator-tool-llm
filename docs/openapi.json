        ],
        "title": "Body_upload_api_llm_sessions_upload_post"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "selectedDbIds": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Selecteddbids"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Issue": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "default": ""
          },
          "source": {
            "type": "string",
            "enum": [
              "evidence",
              "builder",
              "resolver",
              "emitter",
              "pipeline",
              "existing",
              "qa"
            ],
            "title": "Source"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "action"
            ],
            "title": "Severity",
            "default": "warning"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "reaction_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reaction Key"
          },
          "participant_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Participant Key"
          },
          "instance_db_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance Db Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved",
              "dismissed"
            ],
            "title": "Status",
            "default": "open"
          }
        },
        "type": "object",
        "required": [
          "source",
          "code",
          "message"
